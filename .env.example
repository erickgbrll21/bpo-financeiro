# URL do projeto, em Project Settings → Data API. Ex.: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave publishable (sb_publishable_...). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secret (sb_secret_...). Só no servidor. Não use o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Senha do Postgres. Só para migração, nunca no navegador.
SUPABASE_DB_PASSWORD=
